# Copy to .env and replace EVERY "change-me" value. Never commit .env.
#   Strong random value:  openssl rand -base64 24

# --- General -------------------------------------------------------------
TZ=Europe/Belgrade

# Images. "stable"/"latest" are convenient; for reproducible updates pin an
# exact version tag here and upgrade deliberately (read release notes).
HA_IMAGE=ghcr.io/home-assistant/home-assistant:stable
MOSQUITTO_IMAGE=eclipse-mosquitto:2
Z2M_IMAGE=koenkk/zigbee2mqtt:latest
ZWAVE_IMAGE=zwavejs/zwave-js-ui:latest
MATTER_IMAGE=ghcr.io/home-assistant-libs/python-matter-server:stable
OTBR_IMAGE=openthread/otbr:latest
ESPHOME_IMAGE=ghcr.io/esphome/esphome:stable

# --- MQTT (Mosquitto) ----------------------------------------------------
# Interface the broker listens on. 0.0.0.0 = whole LAN (needed for
# ESPHome/Tasmota devices); 127.0.0.1 = this machine only.
MQTT_BIND=0.0.0.0
MQTT_HA_USER=homeassistant
MQTT_HA_PASSWORD=change-me
MQTT_Z2M_USER=zigbee2mqtt
MQTT_Z2M_PASSWORD=change-me

# --- Zigbee2MQTT (profile: zigbee) ---------------------------------------
# Use the stable path from:  ls -l /dev/serial/by-id/
ZIGBEE_ADAPTER_PATH=/dev/serial/by-id/change-me
# zstack (TI, e.g. Sonoff ZBDongle-P), ember (Silicon Labs EFR32, e.g.
# ZBDongle-E with recent firmware), deconz (ConBee), zigate, zboss
ZIGBEE_ADAPTER_TYPE=zstack
Z2M_FRONTEND_BIND=0.0.0.0

# --- Z-Wave JS UI (profile: zwave) ---------------------------------------
ZWAVE_ADAPTER_PATH=/dev/serial/by-id/change-me
ZWAVE_SESSION_SECRET=change-me
ZWAVE_UI_BIND=0.0.0.0

# --- OpenThread Border Router (profile: thread) --------------------------
THREAD_RCP_PATH=/dev/serial/by-id/change-me
THREAD_RCP_BAUDRATE=460800

# --- ESPHome dashboard (profile: esphome) --------------------------------
ESPHOME_USERNAME=admin
ESPHOME_PASSWORD=change-me
